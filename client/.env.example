# Backend API URL
# Development: Leave empty to use proxy configured in vite.config.js
# Production: Set to your deployed backend URL

# Example for local development:
# VITE_API_URL=

# Example for production (Render):
# VITE_API_URL=https://campus-placement-portal-fwbo.onrender.com

# Example for production (other backends):
# VITE_API_URL=https://your-backend-url.com
